### 회원 가입
POST localhost:8080/api/v1/auth/signup/student
Content-Type: application/json

{
  "email": "",
  "password": "",
  "name": ""
}

### 이메일 인증코드 발송
POST localhost:8080/api/v1/auth/email/send
Content-Type: application/json

{
  "email": ""
}

### 이메일 인증코드 값 인증
POST localhost:8080/api/v1/auth/email/verify
Content-Type: application/json

{
  "email": "",
  "code": ""
}


### 로그인
POST localhost:8080/api/v1/auth/login
Content-Type: application/json

{
  "email": "student1@momo.city",
  "password": "password123"
}


> {%
    // 🔴 로그인 성공 시 나오는 accessToken을 인텔리제이 메모리에 'auth_token'이라는 이름으로 자동 저장!
    client.global.set("auth_token", response.body.data.accessToken);
%}

### 내 친구 목록
GET localhost:8080/api/v1/friends
Authorization: Bearer {{auth_token}}

### 사용자 검색
GET localhost:8080/api/v1/friends/find?nickname=자
Authorization: Bearer {{auth_token}}

### 친구 요청: 1번 유저에게 친구 요청 -> notification 행 추가
POST localhost:8080/api/v1/friends/request/14
Authorization: Bearer {{auth_token}}

### 수강신청 후 친구 자동 추가
POST http://localhost:8080/api/v1/lectures/5/enrollments
Authorization: Bearer {{auth_token}}

### v2 - 수강신청 후 친구 자동 추가
POST http://localhost:8080/api/v1/lectures/5/enrollments?position=1
Authorization: Bearer {{auth_token}}

### 친구 요청 철회 -> notifcation 행 삭제
DELETE localhost:8080/api/v1/friends/request/21
Authorization: Bearer {{auth_token}}

### 보낸 친구 요청 목록
GET localhost:8080/api/v1/friends/sent
Authorization: Bearer {{auth_token}}

### 친구 요청 수락(7번이 1번의 요청 수락)
PATCH localhost:8080/api/v1/friends/received/12/accept
Authorization: Bearer {{auth_token}}

### 친구 요청 거절(7번이 1번의 요청 거절)
DELETE localhost:8080/api/v1/friends/received/12/reject
Authorization: Bearer {{auth_token}}

### 받은 친구 요청 목록
GET localhost:8080/api/v1/friends/received
Authorization: Bearer {{auth_token}}

### 친구 차단
PATCH localhost:8080/api/v1/friends/block/26
Authorization: Bearer {{auth_token}}

### 차단한 목록
GET localhost:8080/api/v1/friends/blocked
Authorization: Bearer {{auth_token}}

### 친구 차단 해제
PATCH localhost:8080/api/v1/friends/unblock/26
Authorization: Bearer {{auth_token}}

### 친구 삭제
DELETE localhost:8080/api/v1/friends/delete/19
Authorization: Bearer {{auth_token}}

### v2 - 학생 외, 비활성 유저 제외 친구 목록
GET localhost:8080/api/v2/studentfriends
Authorization: Bearer {{auth_token}}

### v2 - 방명록 목록 조회
GET localhost:8080/api/v2/friends/guest
Authorization: Bearer {{auth_token}}

### v2 - 방명록 작성
POST localhost: 8080/api/v2/friends/guests/register/18
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "content": "방명록 친구"
}

### v3 - 방명록 목록 조회(내가 쓴 것, 남이 쓴 것)
GET localhost:8080/api/v3/friends/guests/19
Authorization: Bearer {{auth_token}}